# ==============================================================================
# BACKEND DJANGO - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env:  cp .env.example .env
# 2. Rellena los valores con tus credenciales REALES
# 3. NUNCA subas el archivo .env al repositorio
# ==============================================================================

# DEBUG MODE (False en producción)
DEBUG=True

# DJANGO SECRET KEY
# Genera uno nuevo con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=GENERA_UNA_NUEVA_SECRET_KEY_AQUI

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DATABASE_NAME=db_arte
DATABASE_USER=root
DATABASE_PASSWORD=CAMBIA_ESTE_PASSWORD
DATABASE_HOST=localhost
DATABASE_PORT=3306

# ==============================================================================
# FRONTEND URL (para CORS/CSRF)
# ==============================================================================
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# AWS S3 CONFIGURATION
# ==============================================================================
AWS_S3_CUSTOM_DOMAIN=tu-cloudfront-domain.cloudfront.net
AWS_ACCESS_KEY_ID=TU_AWS_ACCESS_KEY_ID_AQUI
AWS_SECRET_ACCESS_KEY=TU_AWS_SECRET_ACCESS_KEY_AQUI
AWS_STORAGE_BUCKET_NAME=tu-bucket-name

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
# Gmail SMTP
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-aqui

# SendGrid (opcional)
SENDGRID_API_KEY=SG.TU_SENDGRID_API_KEY_AQUI
DEFAULT_FROM_EMAIL=Tu App <tu-email@ejemplo.com>

# ==============================================================================
# NOTAS DE SEGURIDAD
# ==============================================================================
# - NUNCA uses credenciales reales en este archivo
# - Este archivo .env.example es un TEMPLATE
# - Copia a .env y llena con valores reales
# - El archivo .env debe estar en .gitignore
# ==============================================================================